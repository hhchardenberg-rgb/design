// HHC Hardenberg Hub — datamodel
// Zie MASTERPROMPT sectie 21 voor de functionele achtergrond van dit model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth & gebruikers
// ---------------------------------------------------------------------------

// USER blijft in de enum staan als legacy-waarde van het oude, enkelvoudige
// `role`-veld (zie hieronder) — nieuwe code kent nooit USER toe aan `roles`.
// HUB en TICKETING zijn de eerste twee "sectie"-rollen naast ADMIN; nieuwe
// rollen kunnen hier simpelweg worden toegevoegd (zie ook src/lib/roles.ts).
enum Role {
  USER
  ADMIN
  HUB
  TICKETING
  // Beheerder van één onderdeel: beheert de inhoud en de gebruikers van alleen dat onderdeel.
  HUB_ADMIN
  TICKETING_ADMIN
}

// Houdt inlogpogingen bij (geslaagd én mislukt) zodat login() in
// src/lib/auth.ts brute-force/credential-stuffing kan afremmen — vóór dit
// model bestond er helemaal geen rate limiting op inloggen. Database-backed
// (i.p.v. in-memory) omdat Vercel's serverless functions geen gedeeld
// geheugen hebben tussen instanties; dit werkt dus betrouwbaar ongeacht
// hoeveel functie-instanties er tegelijk draaien. Rijen ouder dan de
// gehanteerde tijdsvensters worden bij elke nieuwe poging opportunistisch
// opgeruimd (zie recordLoginAttempt() in src/lib/login-rate-limit.ts) —
// geen aparte cronjob nodig voor dit kleinschalige gebruik.
model LoginAttempt {
  id        String   @id @default(cuid())
  // Genormaliseerd e-mailadres (zie normalizeEmail()) — ook bijgehouden
  // voor een niet-bestaand account, zodat een aanvaller niet via het
  // uitblijven van een lockout kan afleiden welke e-mailadressen wél
  // bestaan.
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // Legacy: het oorspronkelijke enkelvoudige rolveld. Niet meer gelezen door
  // nieuwe autorisatielogica, maar bewust behouden (en bij elke wijziging via
  // /api/admin/users meeveranderd) zodat bestaande data nooit verloren gaat
  // en er geen aparte migratie nodig is om ADMIN/USER-informatie te bewaren.
  role         Role     @default(USER)
  // Nieuwe bron van waarheid: een gebruiker kan nul of meer rollen hebben
  // (bv. zowel HUB als TICKETING). Leeg (`[]`) betekent "nog niet
  // gemigreerd" — zie effectiveRoles() in src/lib/roles.ts, dat in dat geval
  // terugvalt op het legacy `role`-veld zodat bestaande accounts nooit
  // toegang verliezen. Wordt automatisch éénmalig gevuld (zie
  // backfillUserRoles in src/lib/user-roles.server.ts).
  roles        Role[]   @default([])
  // Profiel: vrijwillig in te vullen door de gebruiker zelf.
  phone        String?
  jobTitle     String?
  // Herinneringsmail van Commerciële Zaken; standaard aan. false = uit (blijft zo).
  notifyCommercialDigest Boolean @default(true)
  // Eigen frequentie (DAILY | TWICE_WEEKLY | WEEKLY | BIWEEKLY | MONTHLY | OFF); null = standaard van Commerciële Zaken.
  commercialDigestFrequency String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  generatedDesigns GeneratedDesign[]
  uploadedAssets   UploadedAsset[]
  templatesCreated Template[]        @relation("TemplateCreatedBy")
  newsPosts        NewsPost[]
  pressReleases    PressRelease[]

  totpCredential            TotpCredential?
  recoveryCodes             RecoveryCode[]
  webauthnCredentials       WebAuthnCredential[]
  passwordResetTokens       PasswordResetToken[]
  commercialMembership      CommercialMembership?
  commercialTeamMemberships CommercialTeamMember[]

  @@map("users")
}

// Wachtwoord-vergeten-flow (zie src/lib/password-reset.ts). Alleen de hash
// van het token wordt opgeslagen (zelfde reden als bij RecoveryCode: zo
// heeft een eventuele databaselek geen bruikbare resetlinks op te leveren).
// `ip` wordt bewaard om, naast de limiet per e-mailadres, ook aanvragen
// vanaf één adres over meerdere accounts heen af te remmen.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  ip        String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Tweefactorauthenticatie (TOTP) — zie src/lib/mfa/
// ---------------------------------------------------------------------------

// Eén TOTP-koppeling per gebruiker (één Authenticator-app tegelijk — een
// gebruiker die van telefoon wisselt, zet opnieuw op in plaats van meerdere
// te beheren, in lijn met hoe TOTP in de praktijk gebruikt wordt).
model TotpCredential {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // AES-256-GCM-versleuteld (zie src/lib/mfa/crypto.ts) — nooit in platte
  // tekst opgeslagen of na activering opnieuw naar de client gestuurd.
  encryptedSecret String

  // null = net aangemaakt, wacht nog op de eerste geverifieerde code
  // (stap 1-6 uit de opdracht: pas na succesvolle verificatie actief).
  // Een niet-geverifieerde rij telt dus nergens mee als "TOTP is actief".
  verifiedAt DateTime?

  // Laatste tijdstap waarvoor een code is geaccepteerd — voorkomt dat
  // dezelfde zescijferige code tweemaal binnen hetzelfde tijdvak
  // (opnieuw) gebruikt kan worden.
  lastUsedStep BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("totp_credentials")
}

// Eenmalige herstelcodes — aangemaakt zodra TOTP wordt geactiveerd, en
// opnieuw gegenereerd op aanvraag (zie opdracht sectie 2, stap 8 en
// sectie 6). Alleen gehasht bewaard: een datalek van deze tabel geeft geen
// bruikbare codes, net zoals bij wachtwoorden.
model RecoveryCode {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("recovery_codes")
}

// Een passkey (WebAuthn/FIDO2) — een gebruiker kan er meerdere koppelen
// (telefoon, laptop, fysieke sleutel). Gebruikt zowel als tweede factor
// (naast wachtwoord) als voor volledig wachtwoordloos inloggen — zie
// src/lib/webauthn/.
model WebAuthnCredential {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Base64url credential-ID zoals de authenticator die teruggeeft —
  // uniek over ALLE gebruikers (nodig om bij wachtwoordloos inloggen de
  // bijbehorende gebruiker te vinden vóórdat die bekend is).
  credentialId String   @unique
  // COSE-publieke sleutel (ruwe bytes) — nooit een privésleutel; die blijft
  // altijd op het apparaat van de gebruiker.
  publicKey    Bytes
  // Signature-counter voor clone-detectie. Veel synced passkeys
  // (iCloud Keychain, Google Password Manager) rapporteren hier altijd 0 —
  // zie verifyWebauthnAuthentication() in src/lib/webauthn/service.ts voor
  // hoe daarmee wordt omgegaan.
  counter      Int      @default(0)
  transports   String[]
  // "singleDevice" (bv. een fysieke sleutel) of "multiDevice" (een
  // gesynchroniseerde passkey) — puur informatief voor de gebruiker.
  deviceType   String
  backedUp     Boolean  @default(false)

  // Door de gebruiker gekozen naam, bv. "iPhone" of "Beveiligingssleutel".
  name       String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("webauthn_credentials")
}

// Tijdelijke opslag voor een WebAuthn-challenge tussen het genereren van de
// registratie-/inlogopties en het verifiëren van het antwoord — nodig omdat
// dat twee losse requests zijn en Vercel's serverless functions geen
// gedeeld geheugen hebben (zelfde reden als LoginAttempt in
// src/lib/login-rate-limit.ts). Elke rij wordt bij verificatie direct
// verwijderd (zie findAndConsumeChallenge in src/lib/webauthn/service.ts),
// dus een challenge is hoe dan ook maar één keer bruikbaar; de index op
// createdAt is alleen voor de opportunistische opruiming van verlopen,
// nooit-afgemaakte pogingen.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  // null = wachtwoordloos inloggen (de gebruiker is nog niet bekend —
  // zie userHandle in het antwoord van de authenticator).
  userId    String?
  purpose   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("webauthn_challenges")
}

// ---------------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------------

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Template {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  description  String?
  category     String
  thumbnailUrl String?
  status       TemplateStatus @default(DRAFT)
  sortOrder    Int            @default(0)

  activeVersionId String?          @unique
  activeVersion   TemplateVersion? @relation("ActiveVersion", fields: [activeVersionId], references: [id])

  createdById String?
  createdBy   User?   @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions TemplateVersion[] @relation("TemplateVersions")

  @@map("templates")
}

model TemplateVersion {
  id            String         @id @default(cuid())
  templateId    String
  template      Template       @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  versionNumber Int
  status        TemplateStatus @default(DRAFT)

  width  Int
  height Int

  // Genormaliseerde template-definitie (lagen, velden, posities, typography).
  // Gevalideerd met Zod, zie src/lib/validations/template.ts
  schemaJson Json

  exportFormats String[] @default(["PNG", "JPG", "WEBP"])

  sourcePsdAssetId String?
  sourcePsdAsset   TemplateAsset? @relation("SourcePsd", fields: [sourcePsdAssetId], references: [id])

  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  fields           TemplateField[]
  assets           TemplateAsset[]   @relation("VersionAssets")
  generatedDesigns GeneratedDesign[]
  activeFor        Template?         @relation("ActiveVersion")

  @@unique([templateId, versionNumber])
  @@map("template_versions")
}

enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  SCORE
  DATE
  TIME
  DROPDOWN
  CHECKBOX
  IMAGE
  LOGO
  BRAND_COLOR
}

enum TextTransform {
  NONE
  UPPERCASE
  LOWERCASE
  CAPITALIZE
}

model TemplateField {
  id                String          @id @default(cuid())
  templateVersionId String
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)

  key   String // technische naam, matcht layerId in schemaJson (bv. "opponent", "player_name")
  label String

  type          FieldType
  required      Boolean       @default(false)
  defaultValue  String?
  placeholder   String?
  maxLength     Int?
  textTransform TextTransform @default(NONE)
  options       Json? // voor DROPDOWN: string[] of {label,value}[]

  // Afbeeldingsvelden
  imageFit          String? // "contain" | "cover"
  imageAspectRatio  String? // bv. "1:1", "4:5"
  allowTransparency Boolean @default(false)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateVersionId, key])
  @@map("template_fields")
}

enum TemplateAssetKind {
  SOURCE_PSD
  BACKGROUND
  THUMBNAIL
  PREVIEW
}

model TemplateAsset {
  id     String            @id @default(cuid())
  kind   TemplateAssetKind
  url    String
  width  Int?
  height Int?
  bytes  Int?

  templateVersionId String?
  templateVersion   TemplateVersion? @relation("VersionAssets", fields: [templateVersionId], references: [id], onDelete: Cascade)

  usedAsSourceFor TemplateVersion[] @relation("SourcePsd")

  createdAt DateTime @default(now())

  @@map("template_assets")
}

// ---------------------------------------------------------------------------
// Huisstijl: fonts & kleuren
// ---------------------------------------------------------------------------

model Font {
  id       String  @id @default(cuid())
  name     String // weergavenaam, bv. "HHC Display"
  family   String // CSS font-family
  weight   Int     @default(400)
  style    String  @default("normal") // normal | italic
  format   String // woff2 | woff | ttf | otf
  fileUrl  String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@map("fonts")
}

model BrandColor {
  id        String @id @default(cuid())
  name      String
  hex       String
  group     String @default("algemeen") // bv. "primair", "secundair", "team"
  sortOrder Int    @default(0)

  @@map("brand_colors")
}

// ---------------------------------------------------------------------------
// Agenda
// ---------------------------------------------------------------------------

enum AgendaEventSource {
  MANUAL // rechtstreeks toegevoegd door een beheerder
  ICS // uitgelicht vanuit de live Google Agenda-koppeling (zie src/lib/calendar.ts)
}

model AgendaEvent {
  id     String            @id @default(cuid())
  source AgendaEventSource @default(MANUAL)
  // Koppelt een ICS-agendapunt (uid + starttijd, zie CalendarEvent.id) aan dit
  // record, zodat uitlichten/toelichten niet dubbel kan en overleeft als de
  // beheerder het item nogmaals opent. Alleen gezet bij source = ICS.
  icsUid String?           @unique

  title       String
  description String? // de "meer uitleg" die achter het event getoond wordt
  location    String?
  start       DateTime
  end         DateTime?
  isFullDay   Boolean   @default(false)
  highlighted Boolean   @default(false) // toont het event op de hub-homepage

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agenda_events")
}

// ---------------------------------------------------------------------------
// Fotobank
// ---------------------------------------------------------------------------

model StockPhoto {
  id        String  @id @default(cuid())
  title     String
  category  String  @default("algemeen")
  url       String
  width     Int?
  height    Int?
  mimeType  String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@map("stock_photos")
}

// ---------------------------------------------------------------------------
// Interne nieuwsfeed
// ---------------------------------------------------------------------------

model NewsPost {
  id       String  @id @default(cuid())
  title    String
  body     String
  category String? // bv. "Design", "Sponsoring", "Vrijwilligers", "Communicatie", "Social media", "Magazine", "Wedstrijden"
  pinned   Boolean @default(false) // vastgezet bovenaan de nieuwsfeed en hub-homepage
  imageUrl String?
  // Bij welke onderdelen het bericht staat: "hub" (Communicatie), "ticketing" en/of "commercial".
  // Alleen wie toegang heeft tot een van die onderdelen ziet het bericht (zie src/lib/news.ts).
  sections String[] @default(["hub"])

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news_posts")
}

// Nieuws per onderdeel aan of uit, in te stellen door de beheerders van dat onderdeel.
// Geen rij = aan.
model NewsSectionSetting {
  section     String   @id // "hub" | "ticketing" | "commercial"
  enabled     Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("news_section_settings")
}

// ---------------------------------------------------------------------------
// Persberichten
// ---------------------------------------------------------------------------

model PressRelease {
  id    String   @id @default(cuid())
  title String
  date  DateTime

  lead String // vetgedrukte inleidende alinea
  body String // overige alinea's, gescheiden door een lege regel

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("press_releases")
}

// ---------------------------------------------------------------------------
// Kennisbank / handleidingen
// ---------------------------------------------------------------------------

model KnowledgeArticle {
  id        String  @id @default(cuid())
  title     String
  body      String? // leeg = nog te schrijven, getoond als "nog niet ingevuld"
  category  String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("knowledge_articles")
}

// ---------------------------------------------------------------------------
// Ticketing (afgeschermd — zie src/lib/roles.ts en src/middleware.ts)
// ---------------------------------------------------------------------------

model TicketingArticle {
  id        String  @id @default(cuid())
  title     String
  body      String? // leeg = nog te schrijven, getoond als "nog niet ingevuld"
  category  String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticketing_articles")
}

model TicketingExcelTemplate {
  id          String  @id @default(cuid())
  title       String
  description String?
  category    String?
  url         String
  fileName    String
  fileSize    Int?
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticketing_excel_templates")
}

model TicketingEmailTemplate {
  id        String  @id @default(cuid())
  title     String // korte naam, bv. "Seizoenspas opnieuw verstuurd"
  subject   String? // onderwerpregel
  // Platte tekst (geen Markdown) — moet direct bruikbaar zijn als je 'm
  // kopieert naar een mailprogramma.
  body      String
  category  String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticketing_email_templates")
}

// ---------------------------------------------------------------------------
// Crisiscommunicatie
// ---------------------------------------------------------------------------

model CrisisProtocol {
  id    String @id @default(cuid())
  title String // type incident, bv. "Ernstige blessure"

  description       String? // korte omschrijving van de situatie
  whoToCall         String? // wie bellen
  whoMayCommunicate String? // wie mag hierover communiceren
  steps             String? // eventuele extra stappen/uitleg

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("crisis_protocols")
}

// ---------------------------------------------------------------------------
// Contactpersonen
// ---------------------------------------------------------------------------

model Contact {
  id   String @id @default(cuid())
  name String
  role String // functie/rol binnen Team Communicatie

  email    String?
  phone    String?
  notes    String? // bv. bereikbaarheid of aandachtsgebied
  photoUrl String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Club, teams & spelers
// ---------------------------------------------------------------------------

model Club {
  id        String  @id @default(cuid())
  name      String
  shortName String?
  logoUrl   String?
  isOwnClub Boolean @default(false)

  teams Team[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clubs")
}

model Team {
  id          String  @id @default(cuid())
  clubId      String
  club        Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name        String // bv. "HHC Hardenberg 1"
  shortName   String? // bv. "HHC 1"
  logoUrl     String?
  competition String?
  ageGroup    String? // "Senioren" | "Vrouwen" | "O23" | "O19" | ...

  players     Player[]
  homeMatches Match[]  @relation("TeamHomeMatches")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teams")
}

model Player {
  id        String  @id @default(cuid())
  teamId    String
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  number    Int?
  position  String? // Keeper | Verdediger | Middenvelder | Aanvaller
  photoUrl  String?
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("players")
}

// Tegenstanders-bibliotheek (los van eigen club/teamstructuur)
model Opponent {
  id           String  @id @default(cuid())
  name         String
  shortName    String?
  logoUrl      String?
  primaryColor String?

  matches Match[] @relation("OpponentMatches")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("opponents")
}

// ---------------------------------------------------------------------------
// Wedstrijden
// ---------------------------------------------------------------------------

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
}

model Match {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation("TeamHomeMatches", fields: [teamId], references: [id], onDelete: Cascade)
  opponentId String
  opponent   Opponent @relation("OpponentMatches", fields: [opponentId], references: [id])

  isHome      Boolean  @default(true)
  date        DateTime
  competition String?
  round       String?
  location    String?

  scoreHome Int?
  scoreAway Int?
  status    MatchStatus @default(SCHEDULED)

  generatedDesigns GeneratedDesign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("matches")
}

// ---------------------------------------------------------------------------
// Gegenereerde designs & uploads
// ---------------------------------------------------------------------------

enum DesignStatus {
  DRAFT
  COMPLETED
}

model GeneratedDesign {
  id                String          @id @default(cuid())
  templateVersionId String
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  matchId String?
  match   Match?  @relation(fields: [matchId], references: [id], onDelete: SetNull)

  title    String?
  status   DesignStatus @default(DRAFT)
  formData Json // huidige veldwaarden (tekst, afbeeldingverwijzingen, crop-info)

  exportUrl    String?
  exportFormat String?
  width        Int?
  height       Int?

  // Optimistische revisiecontrole: elke geslaagde opslag verhoogt dit getal.
  // Een opslag die op een oudere revisie is gebaseerd wordt geweigerd
  // (conflict tussen tabbladen/gebruikers) en een export rendert altijd een
  // expliciet genoemde, opgeslagen revisie.
  revision Int @default(0)

  exports DesignExport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("generated_designs")
}

// Definitieve export van één opgeslagen ontwerprevisie. `renderKey` is een
// hash over alle invoer die het resultaat bepaalt (ontwerp, revisie,
// templateversie, formaat, fonts, rendererversie): dezelfde invoer levert
// hetzelfde bestand op in plaats van een tweede render.
model DesignExport {
  id       String          @id @default(cuid())
  designId String
  design   GeneratedDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  revision          Int
  templateVersionId String
  renderKey         String @unique
  rendererVersion   String
  format            String
  url               String
  storageKey        String
  width             Int
  height            Int
  bytes             Int

  createdAt DateTime @default(now())

  @@index([designId])
  @@map("design_exports")
}

enum UploadedAssetKind {
  PHOTO
  LOGO
  SPONSOR
}

model UploadedAsset {
  id       String            @id @default(cuid())
  userId   String?
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind     UploadedAssetKind @default(PHOTO)
  url      String
  width    Int?
  height   Int?
  mimeType String?
  // Opslagsleutel en omvang, voor referentiegebaseerd opruimen (leeg bij oudere uploads).
  storageKey String?
  bytes      Int?

  createdAt DateTime @default(now())

  @@map("uploaded_assets")
}

// ---------------------------------------------------------------------------
// Commerciële Zaken — toegang en fijnmazige rechten (alleen additief)
// ---------------------------------------------------------------------------
// Sectietoegang staat los van de rollen in `User.roles`: wie ADMIN is, heeft
// hier GEEN toegang zonder expliciet lidmaatschap. Effectieve rechten worden
// bij elk verzoek uit deze tabellen berekend (zie src/lib/commercial), niet
// uit het JWT, zodat intrekken direct werkt.

enum CommercialOverrideEffect {
  ALLOW
  DENY
}

// Herbruikbaar sjabloon: een lijst concrete bevoegdheden ("onderdeel:actie").
model CommercialRole {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships CommercialMembership[]

  @@map("commercial_roles")
}

// Eén rij = deze gebruiker heeft toegang tot de sectie Commerciële Zaken.
model CommercialMembership {
  id          String          @id @default(cuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String?
  role        CommercialRole? @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  overrides CommercialPermissionOverride[]
  scopes    CommercialMemberScope[]

  @@index([roleId])
  @@map("commercial_memberships")
}

// Individuele uitzondering op de rol: expliciet toestaan of blokkeren.
model CommercialPermissionOverride {
  id           String                   @id @default(cuid())
  membershipId String
  membership   CommercialMembership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission   String
  effect       CommercialOverrideEffect
  createdAt    DateTime                 @default(now())

  @@unique([membershipId, permission])
  @@map("commercial_permission_overrides")
}

// Wie wijzigde wat en wanneer. Bewust zonder foreign keys: de historie moet
// blijven bestaan als een gebruiker later verwijderd wordt.
model CommercialAuditEvent {
  id           String   @id @default(cuid())
  actorId      String?
  actorLabel   String?
  targetUserId String?
  action       String
  entity       String
  entityId     String?
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@map("commercial_audit_events")
}

// ---------------------------------------------------------------------------
// Commerciële Zaken — fase 3: bedrijven, contacten, historie, taken (additief)
// ---------------------------------------------------------------------------

enum CommercialScope {
  OWN
  TEAM
  ALL
}

// Recordbereik per onderdeel en lid. Geen rij = geen beperking op eigenaarschap
// door de bevoegdheden zelf; de default wordt in code bepaald (zie scope.ts).
model CommercialMemberScope {
  id           String               @id @default(cuid())
  membershipId String
  membership   CommercialMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  area         String
  scope        CommercialScope

  @@unique([membershipId, area])
  @@map("commercial_member_scopes")
}

model CommercialTeam {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  members   CommercialTeamMember[]
  companies CommercialCompany[]
  tasks     CommercialTask[]

  @@map("commercial_teams")
}

model CommercialTeamMember {
  teamId String
  team   CommercialTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("commercial_team_members")
}

// Eén bedrijf = één dossier, ongeacht seizoen of aantal contracten.
model CommercialCompany {
  id              String          @id @default(cuid())
  name            String
  tradeName       String?
  // Genormaliseerde naam voor dubbelcontrole (kleine letters, zonder leestekens).
  nameKey         String
  status          String          @default("PROSPECT") // PROSPECT | ACTIVE | FORMER (configureerbaar volgt in fase 4)
  street          String?
  postalCode      String?
  city            String?
  country         String?
  website         String?
  email           String?
  phone           String?
  kvkNumber       String?
  vatNumber       String?
  billingName     String?
  billingEmail    String?
  billingAddress  String?
  industry        String?
  tags            String[]
  sponsorCategory String?
  // Sponsorvorm: HOOFD | PLATINA | GOUD | ZILVER | OVERIG (zie src/lib/commercial/sponsor-tiers.ts).
  sponsorTier     String?
  source          String?
  internalNotes   String?
  // Eigenaarschap bepaalt het recordbereik. Alleen te wijzigen met bereik 'alle'.
  ownerId         String?
  teamId          String?
  team            CommercialTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  // Optimistic locking: wijzigen vereist de versie die de gebruiker zag.
  version         Int             @default(1)
  archivedAt      DateTime?
  // Gezet als dit dossier is samengevoegd in een ander dossier (blijft bewaard, gearchiveerd).
  mergedIntoId    String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  contacts      CommercialContact[]
  activities    CommercialActivity[]
  tasks         CommercialTask[]
  files         CommercialFile[]
  contracts     CommercialContract[]
  opportunities CommercialOpportunity[]

  @@index([nameKey])
  @@index([kvkNumber])
  @@index([ownerId])
  @@index([teamId])
  @@index([sponsorTier])
  @@index([archivedAt])
  @@map("commercial_companies")
}

model CommercialContact {
  id         String            @id @default(cuid())
  companyId  String
  company    CommercialCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name       String
  jobTitle   String?
  email      String?
  phone      String?
  role       String? // contactrol, bv. "Beslisser", "Facturatie"
  notes      String?
  // Volgorde binnen het bedrijf: laagste = eerste contactpersoon. Gelijke waarden vallen terug op aanmaakdatum.
  position   Int               @default(0)
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  activities CommercialActivity[]

  @@index([companyId, position])
  @@map("commercial_contacts")
}

enum CommercialActivityKind {
  CALL
  VISIT
  MEETING
  EMAIL
  WHATSAPP
  QUOTE
  OTHER
}

// Gespreksnotitie, voorlopige toezegging of formele afspraak zijn bewust verschillend.
enum CommercialActivityNature {
  NOTE
  PROVISIONAL
  FORMAL
}

model CommercialActivity {
  id         String                   @id @default(cuid())
  companyId  String
  company    CommercialCompany        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contactId  String?
  contact    CommercialContact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  kind       CommercialActivityKind
  nature     CommercialActivityNature @default(NOTE)
  // Moment van het contact of de geplande afspraak (met tijd).
  occurredAt DateTime
  isPlanned  Boolean                  @default(false)
  summary    String
  followUp   String?
  authorId   String?
  archivedAt DateTime?
  createdAt  DateTime                 @default(now())

  tasks CommercialTask[]

  @@index([companyId, occurredAt])
  @@map("commercial_activities")
}

enum CommercialTaskStatus {
  OPEN
  DONE
}

enum CommercialTaskPriority {
  LOW
  NORMAL
  HIGH
}

model CommercialTask {
  id            String                 @id @default(cuid())
  title         String
  description   String?
  assigneeId    String?
  createdById   String?
  teamId        String?
  team          CommercialTeam?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  dueAt         DateTime?
  priority      CommercialTaskPriority @default(NORMAL)
  status        CommercialTaskStatus   @default(OPEN)
  completedAt   DateTime?
  completedById String?
  companyId     String?
  company       CommercialCompany?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  activityId    String?
  activity      CommercialActivity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  version       Int                    @default(1)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([assigneeId, status])
  @@index([companyId])
  @@index([teamId])
  @@index([dueAt])
  @@map("commercial_tasks")
}

/// Bestanden bij een sponsordossier. De inhoud staat in de opslag onder een willekeurige sleutel;
/// de opslag-URL wordt nooit aan de browser gegeven, downloaden loopt via een beveiligde route.
model CommercialFile {
  id           String            @id @default(cuid())
  companyId    String
  company      CommercialCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category     String            @default("OTHER") // LOGO | CONTRACT | QUOTE | AD | PROOF | OTHER
  name         String
  mimeType     String
  sizeBytes    Int
  sha256       String
  storageKey   String
  // Versies van "hetzelfde" bestand delen een groep; hoogste versie is de actuele.
  versionGroup String
  version      Int               @default(1)
  note         String?
  uploadedById String?
  archivedAt   DateTime?
  createdAt    DateTime          @default(now())

  @@index([companyId, category])
  @@index([versionGroup])
  @@map("commercial_files")
}

/// Sponsorseizoen, bv. "2026/2027".
model CommercialSeason {
  id         String    @id @default(cuid())
  name       String    @unique
  startsOn   DateTime  @db.Date
  endsOn     DateTime  @db.Date
  status     String    @default("DRAFT") // DRAFT | ACTIVE | CLOSED
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contracts CommercialContract[]

  @@map("commercial_seasons")
}

/// Sponsorpakket (sjabloon). Wijzigingen werken niet door in bestaande contracten: die bewaren een momentopname.
model CommercialPackage {
  id                 String    @id @default(cuid())
  name               String
  description        String?
  // Standaardbedrag in eurocenten (financieel gegeven: alleen met bedragenrechten zichtbaar).
  defaultAmountCents Int?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  items     CommercialPackageItem[]
  contracts CommercialContract[]

  @@map("commercial_packages")
}

/// Tegenprestatie-sjabloon binnen een pakket.
model CommercialPackageItem {
  id          String            @id @default(cuid())
  packageId   String
  package     CommercialPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  title       String
  description String?
  quantity    Int               @default(1)
  position    Int               @default(0)

  @@index([packageId])
  @@map("commercial_package_items")
}

/// Sponsorcontract van een bedrijf voor een seizoen.
model CommercialContract {
  id              String             @id @default(cuid())
  companyId       String
  company         CommercialCompany  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  seasonId        String
  season          CommercialSeason   @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  packageId       String?
  package         CommercialPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  status          String             @default("DRAFT") // DRAFT | ACTIVE | ENDED | CANCELLED
  startsOn        DateTime           @db.Date
  endsOn          DateTime           @db.Date
  // Bedrag in eurocenten, exclusief btw; btw wordt pas bij facturatie bepaald.
  amountCents     Int?
  renewalOn       DateTime?          @db.Date // moment om het gesprek over verlengen te voeren
  noticeUntil     DateTime?          @db.Date // uiterste opzegdatum
  autoRenew       Boolean            @default(false)
  notes           String?
  // Wat het pakket bevatte op het moment van afsluiten; los van latere pakketwijzigingen.
  packageSnapshot Json?
  renewedFromId   String?
  // Gezet zodra een indexatie het bedrag heeft aangepast; voorkomt dubbel indexeren.
  indexationId    String?
  version         Int                @default(1)
  archivedAt      DateTime?
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  counterparts CommercialCounterpart[]

  @@index([companyId])
  @@index([seasonId, status])
  @@index([endsOn])
  @@map("commercial_contracts")
}

/// Tegenprestatie: wat HHC aan de sponsor heeft toegezegd.
model CommercialCounterpart {
  id            String             @id @default(cuid())
  contractId    String
  contract      CommercialContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  companyId     String
  title         String
  description   String?
  quantity      Int                @default(1)
  status        String             @default("PLANNED") // PLANNED | IN_PROGRESS | DELIVERED | CANCELLED
  dueOn         DateTime?          @db.Date
  deliveredAt   DateTime?
  responsibleId String?
  notes         String?
  proofFileId   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([contractId])
  @@index([companyId])
  @@map("commercial_counterparts")
}

/// Acquisitiekans: een mogelijke sponsorovereenkomst in de pijplijn.
model CommercialOpportunity {
  id                  String            @id @default(cuid())
  companyId           String
  company             CommercialCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  title               String
  stage               String            @default("LEAD") // LEAD | CONTACTED | PROPOSAL | NEGOTIATION | WON | LOST
  packageId           String?
  // Verwachte waarde in eurocenten (financieel gegeven: alleen met bedragenrechten zichtbaar).
  expectedAmountCents Int?
  expectedCloseOn     DateTime?         @db.Date
  ownerId             String?
  lostReason          String?
  notes               String?
  wonContractId       String?
  stageChangedAt      DateTime          @default(now())
  version             Int               @default(1)
  archivedAt          DateTime?
  createdById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([companyId])
  @@index([stage, archivedAt])
  @@index([ownerId])
  @@map("commercial_opportunities")
}

/// Eén toegepaste indexatieronde (percentage over de verlengingen van een seizoen). Bevat bewust geen bedragen.
model CommercialIndexation {
  id            String   @id @default(cuid())
  seasonId      String
  // Percentage in basispunten (350 = 3,5%).
  basisPoints   Int
  roundingCents Int
  contractCount Int
  appliedById   String
  appliedAt     DateTime @default(now())

  @@index([seasonId])
  @@map("commercial_indexations")
}

/// Doel voor sponsorinkomsten per seizoen (eurocenten, exclusief btw). tier: "ALL" = totaal voor de vereniging,
/// anders een sponsorvorm (HOOFD | PLATINA | GOUD | ZILVER | OVERIG) of "NONE" (sponsoren zonder vorm).
model CommercialGoal {
  id          String   @id @default(cuid())
  seasonId    String
  tier        String
  targetCents Int
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([seasonId, tier])
  @@map("commercial_goals")
}

/// Hoe lang een sponsor zonder contactmoment mag blijven, per sponsorvorm (of "NONE" zonder vorm).
/// Geen regel = geen herinnering voor die groep.
model CommercialContactRule {
  tier         String   @id
  intervalDays Int
  updatedById  String?
  updatedAt    DateTime @updatedAt

  @@map("commercial_contact_rules")
}

/// Algemene instellingen voor de herinneringsmail (één rij, id "default").
model CommercialReminderSettings {
  id               String   @id
  defaultFrequency String
  updatedById      String?
  updatedAt        DateTime @updatedAt

  @@map("commercial_reminder_settings")
}

/// Een sponsor die iemand voor zichzelf op "stil" zette: geen herinneringen meer over contactmomenten
/// en opzegdata van die sponsor. Beheerders zien wie welke sponsor stil zette.
model CommercialReminderMute {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("commercial_reminder_mutes")
}

/// Welke herinneringen al verstuurd zijn; voorkomt dubbele mails bij herhaalde cron-runs.
model CommercialReminderLog {
  id        String   @id @default(cuid())
  userId    String
  kind      String // TASK_DUE | NOTICE
  refId     String
  createdAt DateTime @default(now())

  @@unique([userId, kind, refId])
  @@map("commercial_reminder_logs")
}

/// Mailing aan sponsorcontacten. Ontvangers worden bij voorbereiden vastgelegd (momentopname).
model CommercialMailing {
  id             String    @id @default(cuid())
  subject        String
  bodyText       String
  // Filter op dossierstatus (PROSPECT | ACTIVE | FORMER); leeg = alle.
  audienceStatus String?
  // Filter op sponsorvorm (HOOFD | PLATINA | GOUD | ZILVER | OVERIG); leeg = alle vormen.
  audienceTiers  String[]  @default([])
  status         String    @default("DRAFT") // DRAFT | SENDING | SENT
  createdById    String?
  sentById       String?
  sentAt         DateTime?
  version        Int       @default(1)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recipients CommercialMailingRecipient[]

  @@index([status])
  @@map("commercial_mailings")
}

model CommercialMailingRecipient {
  id                String            @id @default(cuid())
  mailingId         String
  mailing           CommercialMailing @relation(fields: [mailingId], references: [id], onDelete: Cascade)
  companyId         String
  contactId         String?
  email             String
  name              String?
  // PENDING | SENT | DELIVERED | BOUNCED | COMPLAINED | FAILED | SKIPPED
  status            String            @default("PENDING")
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?

  @@unique([mailingId, email])
  @@index([providerMessageId])
  @@index([companyId])
  @@map("commercial_mailing_recipients")
}

/// Adressen die geen mailings meer willen. Wordt altijd gecontroleerd vlak voor verzenden.
model CommercialUnsubscribe {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String // LINK | BOUNCE | COMPLAINT | MANUAL
  createdAt DateTime @default(now())

  @@map("commercial_unsubscribes")
}

/// Verwerkte webhook-gebeurtenissen van de mailprovider; voorkomt dubbel verwerken.
model CommercialMailEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@map("commercial_mail_events")
}

/// Gegevens van HHC voor op facturen. Eén rij (id "singleton"); alles is te wijzigen in de instellingen.
/// Facturen kunnen pas definitief worden als de verplichte velden zijn ingevuld.
model CommercialInvoiceSettings {
  id                String   @id
  legalName         String?
  street            String?
  postalCode        String?
  city              String?
  kvkNumber         String?
  vatNumber         String?
  iban              String?
  paymentTermDays   Int?
  invoicePrefix     String?
  nextInvoiceNumber Int?
  creditPrefix      String?
  nextCreditNumber  Int?
  version           Int      @default(1)
  updatedById       String?
  updatedAt         DateTime @updatedAt

  @@map("commercial_invoice_settings")
}

/// Factuur of creditnota. Een nummer en de afzendergegevens (momentopname) komen pas bij definitief maken.
model CommercialInvoice {
  id                String    @id @default(cuid())
  kind              String    @default("INVOICE") // INVOICE | CREDIT_NOTE
  status            String    @default("DRAFT") // DRAFT | ISSUED
  companyId         String
  contractId        String?
  creditedInvoiceId String?
  number            String?   @unique
  issuedOn          DateTime? @db.Date
  dueOn             DateTime? @db.Date
  // Leveringsdatum of -periode in woorden, bv. "seizoen 2026/2027".
  deliveryText      String?
  buyerName         String
  buyerAddress      String?
  buyerVatNumber    String?
  reference         String?
  supplierSnapshot  Json?
  issuedById        String?
  version           Int       @default(1)
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lines      CommercialInvoiceLine[]
  payments   CommercialPayment[]
  deliveries CommercialInvoiceDelivery[]

  @@index([companyId])
  @@index([creditedInvoiceId])
  @@index([status, kind])
  @@map("commercial_invoices")
}

model CommercialInvoiceLine {
  id          String            @id @default(cuid())
  invoiceId   String
  invoice     CommercialInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Int               @default(1)
  // Eenheidsprijs in eurocenten, exclusief btw.
  unitCents   Int
  // Btw-tarief in basispunten (2100 = 21%); wordt per regel bewust gekozen.
  vatRateBp   Int?

  @@index([invoiceId])
  @@map("commercial_invoice_lines")
}

model CommercialPayment {
  id          String            @id @default(cuid())
  invoiceId   String
  invoice     CommercialInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountCents Int
  paidOn      DateTime          @db.Date
  note        String?
  // Een foute betaling wordt ongeldig gemaakt (blijft zichtbaar), niet verwijderd.
  voidedAt    DateTime?
  voidedById  String?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([invoiceId])
  @@map("commercial_payments")
}

// Logboek van per e-mail verstuurde facturen en creditnota's (ook mislukte pogingen).
model CommercialInvoiceDelivery {
  id                String            @id @default(cuid())
  invoiceId         String
  invoice           CommercialInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  toEmail           String
  subject           String
  status            String // SENT | FAILED
  error             String?
  providerMessageId String?
  sentById          String?
  createdAt         DateTime          @default(now())

  @@index([invoiceId])
  @@map("commercial_invoice_deliveries")
}
