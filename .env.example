# Database
DATABASE_URL="postgresql://hhc:hhc@localhost:5432/hhc_design?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Vereist wanneer de app achter een reverse proxy of op een niet-standaard host draait
AUTH_TRUST_HOST="true"

# Storage: "local" (default, development) or "s3" (production, S3/R2-compatible)
STORAGE_DRIVER="local"

# Alleen nodig wanneer STORAGE_DRIVER=s3 (werkt ook voor Cloudflare R2 / Supabase Storage)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Seed-account voor eerste login (zie prisma/seed.ts)
SEED_ADMIN_EMAIL="beheer@hhchardenberg.nl"
SEED_ADMIN_PASSWORD="wijzig-dit-wachtwoord"

# Alleen nodig om de (productie)database via POST /api/system/seed te
# kunnen seeden zonder het databasewachtwoord te hoeven delen — bijv. op
# Vercel, waar je geen shell hebt. Genereer een lange willekeurige waarde
# (bijv. `openssl rand -hex 32`) en zet 'm alleen tijdelijk in de
# omgevingsvariabelen; verwijder 'm daarna weer als je klaar bent.
SEED_SECRET=""
